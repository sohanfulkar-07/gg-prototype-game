[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

uniform vec4 tile_color_a : source_color = vec4(0.20, 0.32, 0.25, 1.0);
uniform vec4 tile_color_b : source_color = vec4(0.27, 0.39, 0.31, 1.0);
uniform vec4 grid_line_color : source_color = vec4(0.12, 0.18, 0.14, 1.0);
uniform float grid_size = 2.0;

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 coord = world_pos.xz / grid_size;
	vec2 grid_pos = floor(coord);
	float checker = mod(grid_pos.x + grid_pos.y, 2.0);
	
	vec3 col = mix(tile_color_a.rgb, tile_color_b.rgb, checker);
	
	vec2 cell_fract = fract(coord);
	float line_width = 0.04;
	if (cell_fract.x < line_width || cell_fract.y < line_width) {
		col = mix(col, grid_line_color.rgb, 0.6);
	}
	
	ALBEDO = col;
	ROUGHNESS = 0.85;
}
"

